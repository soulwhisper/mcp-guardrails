{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>soulwhisper/renovate-config"],
  "packageRules": [
    {
      // grpcio-tools X.Y requires grpcio>=X.Y, so the grpc stack must be
      // updated atomically — separate PRs per package cannot resolve (#81-83).
      "groupName": "grpc stack",
      "matchPackageNames": ["grpcio", "grpcio-tools", "grpcio-health-checking", "grpcio-status"]
    },
    {
      // Wire-compat critical (proto_check.py guards the contract): majors of
      // the protobuf/grpc stack need a human decision, never auto-merge (#121).
      // The shared config's approveMajorUpdates already gates majors on the
      // dashboard; this makes the intent local and explicit.
      "matchPackageNames": ["protobuf", "grpcio", "grpcio-tools", "grpcio-health-checking", "grpcio-status"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      // Base-image bumps (python digests, dockerfile syntax) are build
      // plumbing, not code changes — CI green is the whole verification.
      // Commit as `ci` so release-please keeps them out of the changelog
      // and never cuts a release for them (ci section is hidden).
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "ci"
    },
    {
      // Python 3.15 is blocked: onnxruntime ships zero cp315 wheels on PyPI
      // (checked 2026-10-16, latest 1.31.0) — pip-audit fails with "No
      // matching distribution" and the 3.15-slim base image could not
      // install requirements either (#129 closed). Revisit when onnxruntime
      // publishes cp315 wheels.
      "matchPackageNames": ["python", "actions/python-versions"],
      "allowedVersions": "<3.15.0-0"
    }
  ]
}
