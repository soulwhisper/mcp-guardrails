  "cards": [
    {
      "dot": "cyan",
      "title": "Double gate",
      "items": [
        "CheckRequest scans params as the TOOL role before forwarding",
        "CheckResponse scans tool output as the ASSISTANT role",
        "Deny surfaces to the agent as JSON-RPC error -32001"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed by default",
      "items": [
        "Scanner errors and timeouts deny under failClosed mode",
        "Unreachable sidecar makes agentgateway deny the exchange",
        "Regex-only fallback keeps guarding when ML deps are absent"
      ]
    },
    {
      "dot": "amber",
      "title": "Honest evidence",
      "items": [
        "One JSONL audit line per decision with a tamper-evident hash chain",
        "OTel spans and counters when an OTLP endpoint is configured",
        "Coverage gaps are bounded by knobs and flagged in the audit record"
      ]
    }
  ]
